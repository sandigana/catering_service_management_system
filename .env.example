APP_NAME="Catering System"
APP_ENV=local
APP_KEY=
# Keep false anywhere other than your own laptop - debug pages leak secrets.
APP_DEBUG=false
# In production use your real https:// address - links in e-mails are built from it.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=catering_db
DB_USERNAME=root
DB_PASSWORD=
# PostgreSQL instead of MySQL (this is what Render uses; there DB_URL is filled in for you):
#DB_CONNECTION=pgsql
#DB_PORT=5432
#DB_URL=postgresql://user:password@host:5432/dbname

# First administrator (php artisan db:seed). Leave ADMIN_PASSWORD empty to get a random one.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

SESSION_DRIVER=database
# Minutes of inactivity before automatic logout.
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
# Production over HTTPS: set true so the login cookie is never sent over plain http.
#SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync = send e-mails immediately (works with no extra setup).
# For production use QUEUE_CONNECTION=database and keep `php artisan queue:work` running.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SMS reminders: log (default, writes to the log) or semaphore (semaphore.co)
SMS_DRIVER=log
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=CaterEase

# Business rules (see config/catering.php)
CATERING_RESCHEDULE_MIN_DAYS=2
CATERING_REMINDER_DAYS=1
CATERING_PROOF_MAX_KB=4096
CATERING_MAX_EVENTS_PER_DAY=3
CATERING_VENUE_SLOT_HOURS=4
CATERING_RECEIPT_PREFIX=OR-

# Behind a proxy/load balancer (e.g. Cloudflare): comma-separated proxy IPs to trust.
TRUSTED_PROXIES=

# Full path to mysqldump if it is not on PATH (used by `php artisan db:backup`).
#MYSQLDUMP_PATH=C:/xampp/mysql/bin/mysqldump.exe
